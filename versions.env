# Pinned inputs. Bump a version and its sha256 (or commit) together.

# VyOS image builder, pinned to a commit of its default branch (rolling). Its
# Dockerfile (docker/) is the build container; its data/defaults.toml picks the
# kernel version; its package.toml pins the out-of-tree kernel modules rebuilt
# against the Pi kernel. VyOS packages themselves come from the rolling
# repository (packages.vyos.net) on the day of the build, which cannot be
# pinned; each image's manifest lists what went in.
VYOS_BUILD_REPO=https://github.com/vyos/vyos-build
VYOS_BUILD_REV=df1c91d8b8855ed644e8cc7dc71158c885ef4a35

# Linux, as VyOS builds it (kernel_version in vyos-build data/defaults.toml at
# VYOS_BUILD_REV; scripts/build-iso.sh checks they agree), plus
# kernel/raspberrypi.config. Also verified against kernel.org's signature by
# vyos-build.
LINUX_VERSION=6.18.62
LINUX_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.62.tar.xz
LINUX_SHA256=490a7aedf1b355c565d3a6c05333ccccb5da82064eca46b590448a7099d7d651

# Out-of-tree kernel modules the image needs (vyos-1x depends on them), rebuilt
# against the Pi kernel by vyos-build's linux-kernel/build.py: the repository's
# copies are built for VyOS's own kernel and would not load.
KERNEL_PACKAGES="linux-kernel accel-ppp-ng jool nat-rtsp ipt-netflow"

# Raspberry Pi 4 UEFI firmware: https://github.com/pftf/RPi4 (latest release;
# GitHub marks this release candidate as the latest. v1.53 is the last final:
# https://github.com/pftf/RPi4/releases/download/v1.53/RPi4_UEFI_Firmware_v1.53.zip
# ca9973e2a7a546b3df871cfb7382e656829114b6dfa424f40dc67cc90a217d88)
RPI4_FW_URL=https://github.com/pftf/RPi4/releases/download/v1.54-rc/RPi4_UEFI_Firmware_v1.54-rc.zip
RPI4_FW_SHA256=33243ecc0120a071eb57c4242570dbcdb38b020344f96189bd67cdef394e6057

# Raspberry Pi 5: no UEFI. The Pi 5's EEPROM bootloader loads the VyOS kernel,
# initrd and the mainline device tree straight from the FAT partition (see
# README, "Pi 5 boot path"); its firmware lives in the EEPROM, so nothing to pin.

# VM tests only: the LAN client that takes a DHCP lease from VyOS (x86_64, KVM).
CIRROS_URL=https://download.cirros-cloud.net/0.6.3/cirros-0.6.3-x86_64-disk.img
CIRROS_SHA256=7d6355852aeb6dbcd191bcda7cd74f1536cfe5cbf8a10495a7283a8396e4b75b
