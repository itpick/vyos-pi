#!/bin/sh
# vyos-pi: boot log to the FAT partition(s) named by vyos-pi.bootlog=, as the
# initramfs hands over to VyOS (root found and mounted).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
[ -x /bin/vyos-pi-bootlog ] && /bin/vyos-pi-bootlog initramfs-done </dev/null
exit 0
