#!/usr/bin/env python3
"""Keep the Raspberry Pi 5's boot files on the FAT partition in step with VyOS.

The Pi 5 image boots without UEFI or GRUB: the Pi's EEPROM bootloader reads
config.txt on the FAT partition and loads, from that partition,

  vyos-pi/boot/Image        the kernel (unwrapped from VyOS's EFI zboot vmlinuz)
  vyos-pi/boot/initrd.img   the initrd
  bcm2712-rpi-5-b.dtb       the mainline device tree (C1); the firmware loads
                            it on every Pi 5, and on D0 boards applies
                            overlays/bcm2712d0.dtbo (from the image build) to it
  bcm2712d0-rpi-5-b.dtb     mainline's D0 tree, in case a firmware loads it
  cmdline.txt               the kernel command line GRUB would have used, plus
                            the Pi 5's consoles and the boot log

VyOS only knows GRUB: "add system image" and "set system image default-boot"
change GRUB's default. This copies the default image's files to the FAT
partition so the Pi boots what GRUB would. vyos-pi-bootsync.service runs it at
boot and again at shutdown (after an upgrade, the reboot then starts the new
image). It does nothing unless the FAT partition has a vyos-pi/boot/ folder,
which only the Pi 5 image has.

  vyos-pi-bootsync [--check]
      on a running VyOS, as root (--check: report only, exit 1 if out of date)
  vyos-pi-bootsync --stage DIR --version V --vmlinuz F --initrd F --dtbs DIR
                   [--esp-partuuid ID]
      at image build time: write the same files into DIR (the ESP's contents)
  vyos-pi-bootsync --patch-dtb IN OUT
      add what the firmware's early watchdog needs to a device tree (used by
      scripts/pi-trial-install.sh for images that predate it)
"""
import argparse
import glob
import gzip
import hashlib
import lzma
import os
import struct
import subprocess
import sys
import tempfile
import time

BOOT_OPTS_STEM = 'boot=live rootdelay=5 noautologin net.ifnames=0 biosdevname=0 vyos-union=/boot/'
# Pi 5 debug UART (3-pin header) is ttyAMA10 with the mainline device tree
# (PL011 at 0x107d001000, also the device tree's stdout-path); HDMI is tty1.
# Kernel messages go to every console=; the last one is /dev/console, which
# also gets the initramfs's and systemd's messages: the UART, because it works
# from the first instruction (earlycon) whatever the firmware does with HDMI.
EARLYCON = 'earlycon=pl011,0x107d001000,115200n8'
CONSOLES = 'console=tty1 console=ttyAMA10,115200'
# No panic= here: VyOS manages that kernel option ("system option kernel
# panic") and, finding one it did not set, tries to kexec into a command line
# without it at every boot. The initramfs sets the panic timeout instead
# (/etc/initramfs-tools/scripts/init-top/00-vyos-pi-bootlog).
BOOTLOG_DIR = '/vyos-pi/boot-log'
# mainline file name -> name(s) the Pi 5 firmware looks for
DTBS = {
    'bcm2712-rpi-5-b.dtb': ['bcm2712-rpi-5-b.dtb'],
    'bcm2712-d-rpi-5-b.dtb': ['bcm2712d0-rpi-5-b.dtb', 'bcm2712-d-rpi-5-b.dtb'],
}
LOG = '/var/log/vyos-pi.log'


def log(msg):
    print(f'vyos-pi-bootsync: {msg}')
    try:
        with open(LOG, 'a') as f:
            f.write(time.strftime('%Y-%m-%dT%H:%M:%S ') + f'bootsync: {msg}\n')
    except OSError:
        pass


FDT_BEGIN_NODE, FDT_END_NODE, FDT_PROP, FDT_NOP, FDT_END = 1, 2, 3, 4, 9


def dtb_early_watchdog(dtb: bytes) -> bytes:
    """Let the Pi 5 firmware start the hardware watchdog for this device tree.

    The firmware arms it before starting the kernel (config.txt
    kernel_watchdog_timeout) only when the device tree's "watchdog" alias
    points at an enabled node with an "early-watchdog" property: what
    "dtparam=watchdog=on" adds on Raspberry Pi's own device trees
    (bcm2712-rpi.dtsi: watchdog = <&watchdog>, "early-watchdog?";, firmware
    2025-07-17 "arm_loader: Also require the early-watchdog property"). The
    mainline tree has neither, nor the __overrides__ that dtparam needs, so add
    both to the PM node (brcm,bcm2712-pm: bcm2835-wdt). Idempotent."""
    magic, total, off_struct, off_strings, off_rsv, version, last_comp, cpu, size_strings, size_struct = \
        struct.unpack_from('>10I', dtb, 0)
    if magic != 0xd00dfeed:
        raise SystemExit('not a device tree blob')
    st = bytearray(dtb[off_struct:off_struct + size_struct])
    strings = bytearray(dtb[off_strings:off_strings + size_strings])

    def name_at(off):
        return bytes(strings[off:strings.index(b'\0', off)])

    def align(n):
        return (n + 3) & ~3

    # Walk the tree: each node's full path, where its properties start (a new
    # property can go right there) and its properties.
    nodes, stack, i = [], [], 0
    while i < len(st):
        tok = struct.unpack_from('>I', st, i)[0]
        i += 4
        if tok == FDT_BEGIN_NODE:
            end = st.index(b'\0', i)
            name = st[i:end].decode()
            i = align(end + 1)
            path = '/' if not stack else nodes[stack[-1]]['path'].rstrip('/') + '/' + name
            nodes.append({'path': path, 'at': i, 'props': {}})
            stack.append(len(nodes) - 1)
        elif tok == FDT_END_NODE:
            stack.pop()
        elif tok == FDT_PROP:
            ln, nameoff = struct.unpack_from('>II', st, i)
            nodes[stack[-1]]['props'][name_at(nameoff)] = bytes(st[i + 8:i + 8 + ln])
            i = align(i + 8 + ln)
        elif tok == FDT_NOP:
            continue
        elif tok == FDT_END:
            break
        else:
            raise SystemExit(f'bad device tree token {tok}')

    pm = [n for n in nodes if b'brcm,bcm2712-pm' in n['props'].get(b'compatible', b'').split(b'\0')]
    aliases = [n for n in nodes if n['path'] == '/aliases']
    if not pm or not aliases:
        raise SystemExit('device tree has no brcm,bcm2712-pm node or no /aliases')
    pm, aliases = pm[0], aliases[0]
    if pm['props'].get(b'status', b'okay\0') not in (b'okay\0', b'ok\0'):
        raise SystemExit(f"{pm['path']} is disabled")
    target = pm['path'].encode() + b'\0'
    want = []  # (insert offset, name, value)
    if b'early-watchdog' not in pm['props']:
        want.append((pm['at'], b'early-watchdog', b''))
    if aliases['props'].get(b'watchdog') != target:
        if b'watchdog' in aliases['props']:
            raise SystemExit('device tree already has a different watchdog alias')
        want.append((aliases['at'], b'watchdog', target))
    if not want:
        return dtb
    for at, name, val in sorted(want, key=lambda w: -w[0]):
        idx = strings.find(name + b'\0')
        while idx > 0 and strings[idx - 1] != 0:  # must start a string
            idx = strings.find(name + b'\0', idx + 1)
        if idx < 0:
            idx = len(strings)
            strings += name + b'\0'
        prop = struct.pack('>III', FDT_PROP, len(val), idx) + val + b'\0' * (align(len(val)) - len(val))
        st[at:at] = prop
    rsv, j = b'', off_rsv
    while True:  # memory reservation entries, up to the (0, 0) terminator
        entry = dtb[j:j + 16]
        rsv += entry
        j += 16
        if entry == b'\0' * 16:
            break
    o_rsv = 40
    o_struct = o_rsv + len(rsv)
    o_strings = o_struct + len(st)
    total = o_strings + len(strings)
    hdr = struct.pack('>10I', 0xd00dfeed, total, o_struct, o_strings, o_rsv, version, last_comp, cpu,
                      len(strings), len(st))
    return hdr + rsv + bytes(st) + bytes(strings)


def kernel_image(data: bytes) -> bytes:
    """An arm64 Image the Pi firmware can load, from a vmlinuz: EFI zboot
    (VyOS's CONFIG_EFI_ZBOOT), gzip, or already an Image."""
    if data[:2] == b'MZ' and data[4:8] == b'zimg':
        off, size = struct.unpack_from('<II', data, 8)
        comp = data[24:32].rstrip(b'\0').decode()
        payload = data[off:off + size]
        if comp == 'gzip':
            data = gzip.decompress(payload)
        elif comp in ('xzkern', 'xz'):
            data = lzma.decompress(payload)
        elif comp == 'lzma':
            data = lzma.decompress(payload, format=lzma.FORMAT_ALONE)
        elif comp in ('zstd22', 'zstd'):
            data = subprocess.run(['zstd', '-dc'], input=payload, stdout=subprocess.PIPE, check=True).stdout
        else:
            raise SystemExit(f'unsupported zboot compression {comp!r}')
    elif data[:2] == b'\x1f\x8b':
        data = gzip.decompress(data)
    if data[0x38:0x3c] != b'ARM\x64':
        raise SystemExit('not an arm64 kernel Image')
    return data


def cmdline(version: str, boot_opts: str = '', esp_partuuid: str = '') -> str:
    """What GRUB passes (BOOT_IMAGE is how VyOS tells which image is running),
    plus the Pi 5's consoles and the boot log (vyos-pi-bootlog) on the FAT
    partition itself."""
    opts = (boot_opts or BOOT_OPTS_STEM + version).split()
    opts += [EARLYCON] + CONSOLES.split()
    if esp_partuuid:
        opts.append(f'vyos-pi.bootlog=PARTUUID={esp_partuuid.lower()}:{BOOTLOG_DIR}')
    return f'BOOT_IMAGE=/boot/{version}/vmlinuz {" ".join(opts)}\n'


def stage_files(version, vmlinuz, initrd, dtb_dir, boot_opts='', esp_partuuid=''):
    """{relative path on the ESP: content}"""
    files = {
        'vyos-pi/boot/Image': kernel_image(open(vmlinuz, 'rb').read()),
        'vyos-pi/boot/initrd.img': open(initrd, 'rb').read(),
        'vyos-pi/boot/version': f'{version}\n'.encode(),
        'cmdline.txt': cmdline(version, boot_opts, esp_partuuid).encode(),
    }
    for src, names in DTBS.items():
        path = os.path.join(dtb_dir, src)
        if not os.path.exists(path):
            raise SystemExit(f'missing device tree {path}')
        dtb = dtb_early_watchdog(open(path, 'rb').read())
        for name in names:
            files[name] = dtb
    return files


def write_files(esp, files, check=False):
    """Write the files that differ; returns the list of changed paths."""
    changed = []
    for rel, content in files.items():
        dst = os.path.join(esp, rel)
        try:
            with open(dst, 'rb') as f:
                same = hashlib.sha256(f.read()).digest() == hashlib.sha256(content).digest()
        except FileNotFoundError:
            same = False
        if same:
            continue
        changed.append(rel)
        if check:
            continue
        os.makedirs(os.path.dirname(dst) or esp, exist_ok=True)
        tmp = dst + '.new'
        with open(tmp, 'wb') as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, dst)
    return changed



def find_esp():
    out = subprocess.run(['bash', '-c', '. /usr/libexec/vyos-pi/common.sh; find_esp'],
                         stdout=subprocess.PIPE, text=True).stdout.strip()
    return out or None


def running():
    from vyos.system import disk, grub, image
    persist = disk.find_persistence()
    if not persist:
        log('no persistence partition (live boot?); nothing to do')
        return 0
    version = image.get_default_image() or image.get_running_image()
    boot_dir = os.path.join(persist, 'boot', version)
    vmlinuz = os.path.join(boot_dir, 'vmlinuz')
    initrd = os.path.join(boot_dir, 'initrd.img')
    if not (os.path.exists(vmlinuz) and os.path.exists(initrd)):
        log(f'default image {version} has no kernel/initrd in {boot_dir}')
        return 1
    boot_opts = grub.get_boot_opts(version, persist)

    esp = find_esp()
    if not esp:
        log('no EFI system partition found')
        return 1
    esp_partuuid = subprocess.run(['blkid', '-s', 'PARTUUID', '-o', 'value', esp],
                                  stdout=subprocess.PIPE, text=True).stdout.strip()
    with tempfile.TemporaryDirectory(prefix='vyos-pi-bootsync.') as tmp:
        mnt = os.path.join(tmp, 'esp')
        os.mkdir(mnt)
        r = subprocess.run(['findmnt', '-no', 'TARGET', esp], stdout=subprocess.PIPE, text=True)
        existing = r.stdout.split()[0] if r.returncode == 0 and r.stdout.strip() else None
        if existing:
            mnt = existing
        else:
            subprocess.run(['mount', '-t', 'vfat', '-o', 'rw,noatime', esp, mnt], check=True)
        try:
            if not os.path.isdir(os.path.join(mnt, 'vyos-pi', 'boot')):
                return 0  # not a direct-boot (Pi 5) image
            # Device trees ship inside the image's root filesystem (the kernel package).
            sq = os.path.join(boot_dir, f'{version}.squashfs')
            sqmnt = os.path.join(tmp, 'sq')
            os.mkdir(sqmnt)
            subprocess.run(['mount', '-t', 'squashfs', '-o', 'ro,loop', sq, sqmnt], check=True)
            try:
                dtb_dirs = sorted(glob.glob(os.path.join(sqmnt, 'usr/lib/linux-image-*/broadcom')))
                if not dtb_dirs:
                    log(f'no device trees in {sq}')
                    return 1
                files = stage_files(version, vmlinuz, initrd, dtb_dirs[-1], boot_opts, esp_partuuid)
            finally:
                subprocess.run(['umount', sqmnt])
            changed = write_files(mnt, files, check=args.check)
            if changed:
                verb = 'out of date' if args.check else 'updated'
                log(f'{verb} for {version}: {" ".join(changed)}')
                if not args.check:
                    os.sync()
                return 1 if args.check else 0
            print(f'vyos-pi-bootsync: boot files match {version}')
            return 0
        finally:
            if not existing:
                subprocess.run(['umount', mnt])


ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
ap.add_argument('--check', action='store_true')
ap.add_argument('--stage')
ap.add_argument('--version')
ap.add_argument('--vmlinuz')
ap.add_argument('--initrd')
ap.add_argument('--dtbs')
ap.add_argument('--esp-partuuid', default='')
ap.add_argument('--patch-dtb', nargs=2, metavar=('IN', 'OUT'))
args = ap.parse_args()

if args.patch_dtb:
    data = dtb_early_watchdog(open(args.patch_dtb[0], 'rb').read())
    with open(args.patch_dtb[1], 'wb') as f:
        f.write(data)
    sys.exit(0)

if args.stage:
    files = stage_files(args.version, args.vmlinuz, args.initrd, args.dtbs, esp_partuuid=args.esp_partuuid)
    for rel in write_files(args.stage, files):
        print(f'   {rel}')
    sys.exit(0)
sys.exit(running())
