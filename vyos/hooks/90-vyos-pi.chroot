#!/bin/sh
# vyos-pi live-build hook (runs in the image chroot after the packages and
# overlay/ are in). scripts/build-iso.sh copies it into vyos-build's
# data/live-build-config/hooks/live/.
set -e

echo "I: vyos-pi: enabling the boot hook, the Pi 5 boot file sync and the boot log"
chmod 755 /usr/libexec/vyos-pi/* \
	/etc/initramfs-tools/hooks/vyos-pi-bootlog /etc/initramfs-tools/scripts/init-top/00-vyos-pi-bootlog \
	/etc/initramfs-tools/scripts/init-premount/vyos-pi-bootlog \
	/etc/initramfs-tools/scripts/init-bottom/vyos-pi-bootlog
systemctl enable vyos-pi-boot.service vyos-pi-bootsync.service vyos-pi-bootlog.service

# Boots that cannot find their root reboot instead of waiting at an
# (initramfs) shell nobody can reach: panic=10 in the boot options VyOS writes
# to GRUB for every image it installs (initramfs-tools and live-boot honour
# it; so does the kernel). The Pi 5's cmdline.txt (vyos-pi-bootsync) has it too.
echo "I: vyos-pi: panic=10 in VyOS's GRUB boot options"
grub_py=/usr/lib/python3/dist-packages/vyos/system/grub.py
grep -q "^BOOT_OPTS_STEM: str = 'boot=live rootdelay=5 noautologin net.ifnames=0 biosdevname=0 vyos-union=/boot/'" "$grub_py"
sed -i "s|^BOOT_OPTS_STEM: str = 'boot=live rootdelay=5 noautologin net.ifnames=0 biosdevname=0 vyos-union=/boot/'|BOOT_OPTS_STEM: str = 'boot=live rootdelay=5 noautologin net.ifnames=0 biosdevname=0 panic=10 vyos-union=/boot/'|" "$grub_py"
grep -q "biosdevname=0 panic=10 vyos-union=" "$grub_py"

# The boot log in the initramfs (etc/initramfs-tools/hooks/vyos-pi-bootlog).
# live-build may build the initramfs again later; scripts/build-iso.sh checks
# the ISO's initrd has it.
echo "I: vyos-pi: rebuilding the initramfs with the boot log"
update-initramfs -u -k all || echo "W: vyos-pi: update-initramfs failed here; relying on live-build's"

# Branding. VyOS's artwork licence (vyos-build LICENSE.artwork) lets self-built
# images be redistributed when the VyOS branding is replaced; scripts/build-iso.sh
# swaps the logo artwork, this replaces the product name where a user sees it
# first: the version line, the boot greeting, the login banner and the
# pre-login issue.
echo "I: vyos-pi: replacing user-visible branding"
sed -i 's/^Version:          VyOS {{version}}/Version:          vyos-pi {{version}}/' /usr/libexec/vyos/op_mode/version.py
grep -q '^Version:          vyos-pi ' /usr/libexec/vyos/op_mode/version.py
sed -i "s/'issue': 'Welcome to VyOS - /'issue': 'vyos-pi - /" /usr/libexec/vyos/conf_mode/system_login_banner.py
grep -q "'issue': 'vyos-pi - " /usr/libexec/vyos/conf_mode/system_login_banner.py
# systemd's boot greeting ("Welcome to ...!") is os-release's PRETTY_NAME
if [ -f /etc/os-release ]; then
	ver=$(. /etc/os-release; echo "${VERSION:-}")
	sed -i "s/^PRETTY_NAME=.*/PRETTY_NAME=\"vyos-pi ${ver}\"/" /etc/os-release
fi
test -f /usr/share/vyos/templates/login/default_motd.j2
cat > /usr/share/vyos/templates/login/default_motd.j2 <<'MOTD'
Welcome to vyos-pi {{ version_data.version }} ({{ version_data.release_train }})

An unofficial build of VyOS for the Raspberry Pi 4 and 5, made from VyOS's
public sources by https://github.com/itpick/vyos-pi. It is not affiliated
with, endorsed or supported by VyOS Networks (Sentrium S.L.) or Raspberry Pi
Ltd. VyOS is a registered trademark of Sentrium S.L.

 * vyos-pi:        https://github.com/itpick/vyos-pi
 * Documentation:  {{ version_data.documentation_url }}

You can change this banner using "set system login banner post-login" command.

This system is free software made of many components; their licences are in
/usr/share/doc/*/copyright.
MOTD

sed -i 's/This VyOS system is not/This vyos-pi system is not/' /usr/share/vyos/templates/login/motd_vyos_nonproduction.j2 2>/dev/null || true

echo "I: vyos-pi: recording package versions in /usr/share/vyos-pi/manifest.txt"
mkdir -p /usr/share/vyos-pi
{
	echo "packages:"
	dpkg-query -W -f '  ${Package} ${Version}\n' 'linux-image-*' vyos-1x accel-ppp-ng jool nat-rtsp vyos-ipt-netflow vyos-linux-firmware grub-efi-arm64-bin suricata suricata-update libhtp2 2>/dev/null
	echo "kernel config (Raspberry Pi options, from kernel/raspberrypi.config):"
	grep -hE '^CONFIG_(MISC_RP1|MACB|BCMGENET|MMC_SDHCI_BRCMSTB|MMC_SDHCI_IPROC|PCIE_BRCMSTB|BCM2712_MIP)=' /boot/config-* | sed 's/^/  /'
} >> /usr/share/vyos-pi/manifest.txt
