#
# vyos-pi: Raspberry Pi 4 (BCM2711) and Pi 5 (BCM2712 + RP1) support on top of
# VyOS's arm64 kernel configuration. scripts/build-iso.sh copies this file into
# vyos-build's scripts/package-build/linux-kernel/config/ as 70-raspberrypi.config,
# so it is merged after VyOS's own fragments; the build fails if any line here
# does not reach the final .config (merge_config.sh's "not in final .config").
#
# Everything the boot path needs before the initrd can load modules is built
# in (=y): SD card controllers, the GPIOs/regulators/pinctrl the Pi 5 SD slot
# needs, PCIe MSI for RP1, and RP1 itself (it also carries the Pi 5's USB).
#

# SoC families. ARCH_BCM2835 is already set by VyOS; BRCMSTB brings the
# BCM2712 interrupt/GPIO/reset blocks.
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_BRCMSTB=y

# SD cards: Pi 4 emmc2 (sdhci-iproc, also matched over ACPI as BRCME88C),
# Pi 4 legacy SDHOST, Pi 5 (sdhci-brcmstb)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_MMC_SDHCI_BRCMSTB=y
CONFIG_MMC_BCM2835=y
CONFIG_GPIO_BRCMSTB=y
CONFIG_PINCTRL_BRCMSTB=y
CONFIG_PINCTRL_BCM2712=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RESET_BRCMSTB=y
CONFIG_RESET_BRCMSTB_RESCAL=y
CONFIG_RESET_RASPBERRYPI=y

# Pi 5: PCIe MSI controller in front of RP1, and RP1 (Ethernet, USB, GPIO)
CONFIG_BCM2712_MIP=y
CONFIG_OF_OVERLAY=y
CONFIG_MISC_RP1=y
CONFIG_COMMON_CLK_RP1=y
CONFIG_PINCTRL_RP1=y

# Ethernet: Pi 4 GENET (DT and ACPI), Pi 5 RP1 GEM (Cadence MACB)
CONFIG_BCMGENET=m
CONFIG_MDIO_BCM_UNIMAC=y
CONFIG_BROADCOM_PHY=m
CONFIG_MACB=m

# USB: Pi 5 ports are DWC3 on RP1; Pi 4 VL805 (xHCI on PCIe, or a platform
# xHCI under UEFI/ACPI) and the USB-C OTG port (DWC2). UAS for USB SSDs.
CONFIG_USB_DWC3=m
CONFIG_USB_XHCI_PLATFORM=m
CONFIG_USB_DWC2=m
CONFIG_USB_UAS=m

# Firmware interfaces, power domains, clocks, cpufreq
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_RASPBERRYPI_POWER=y
CONFIG_BCM2835_POWER=y
CONFIG_CLK_RASPBERRYPI=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=m
CONFIG_DMA_BCM2835=y

# Reboot and watchdog (bcm2835-pm-wdt, also on BCM2712)
CONFIG_BCM2835_WDT=y

# Sensors, thermal, fan
CONFIG_SENSORS_RASPBERRYPI_HWMON=m
CONFIG_BCM2711_THERMAL=m
CONFIG_BRCMSTB_THERMAL=m
CONFIG_PWM=y
CONFIG_PWM_BCM2835=m
CONFIG_PWM_RASPBERRYPI_POE=m
CONFIG_SENSORS_PWM_FAN=m

# Serial: Pi 4 mini UART (the Pi 5 debug UART and Pi 4 UART0 are PL011,
# already built in)
CONFIG_SERIAL_8250_BCM2835AUX=y

# Misc board devices
CONFIG_HW_RANDOM_BCM2835=m
CONFIG_I2C_BCM2835=m
CONFIG_GPIO_RASPBERRYPI_EXP=m
