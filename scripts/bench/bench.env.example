# Copy to bench.env (git-ignored) and adjust. Every script sources it.
ROUTER_KIND=opnsense             # opnsense | vyos  (selects how alerts/IDS stats are read)
ROUTER_IP=192.168.68.1          # router LAN address (opnsense-pi) / pi5-1 for VyOS
ROUTER_SSH=root@192.168.68.1    # ssh target used for read-only stats polling (vyos@<ip> on VyOS)
ROUTER_WAN_IF=rp1eth0           # WAN NIC name on the router (eth0 on VyOS/Linux)
WIRED_IF=en7                    # this Mac's wired LAN interface
WIFI_IP=192.168.72.22           # this Mac's Wi-Fi (LAN2) address, used as iperf3 endpoint
LAN_PEER=nixtop                 # ssh host on the wired LAN running the iperf3 client
DUR=15                          # seconds per throughput run (keep <= 60)
GAP=5                           # pause between runs
STREAMS=8                       # parallel streams for multi-stream runs
PING_TARGET=1.1.1.1             # latency target over the WAN
POLL_INT=2                      # router stats poll interval (s)
